#
# Cluster shape: one gateway.
#
# Everything that does not depend on more than one gateway lives here: plain
# CRUD on subsystems, namespaces, listeners and hosts, and the gateway's own
# introspection commands. A single gateway owns every load balancing group,
# so no suite in this shape ever has to wait for an ANA transition.
#
# shellcheck shell=bash

GATEWAYS=1

# Suites that `run.sh single_gw` does not pick up, and that have to be named
# in full to run: `run.sh single_gw/qos`.
#
# qos is the fio soak (tests/gh_runner/single_gw/qos/qos_fio_run.sh), half an
# hour of IO against a single gateway. It needs the same cluster as the rest
# of this shape, but running it alongside the CLI suites would turn a job that
# takes minutes into one that takes an hour, and the IO load would make the
# statistics the other suites read unstable.
SHAPE_SKIP="qos"
